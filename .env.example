# Copy this to .env and fill in your own free key to enable the optional
# Groq AI-agent layer (paraphrase generation + description polishing).
# Get a free key at https://console.groq.com (no credit card required).
# Everything works without this -- it's a pure enhancement, not a requirement.
GROQ_API_KEY=

# Optional: override the default free-tier model.
# GROQ_MODEL=llama-3.1-8b-instant
